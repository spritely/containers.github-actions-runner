FROM ghcr.io/actions/actions-runner:2.335.1@sha256:08c30b0a7105f64bddfc485d2487a22aa03932a791402393352fdf674bda2c29

# Tool versions
# Obtain the version number from: https://github.com/docker/compose/releases
# renovate: datasource=github-releases depName=docker/compose extractVersion=^v(?<version>.*)$
ARG DOCKER_COMPOSE_VERSION=5.3.0

# yq releases: https://github.com/mikefarah/yq/releases
# renovate: datasource=github-releases depName=mikefarah/yq extractVersion=^v(?<version>.*)$
ARG YQ_VERSION=4.53.3

# dotnet SDK releases: https://github.com/dotnet/sdk/releases
# renovate: datasource=github-releases depName=dotnet/sdk extractVersion=^v(?<version>.*)$
ARG DOTNET_VERSION=10.0.301

USER root

RUN apt-get update \
    && apt-get install -y gh git \
    # Install yq (mikefarah/yq - Go-based YAML processor)
    && curl -fsSL "https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_linux_amd64" -o /usr/local/bin/yq \
    && chmod +x /usr/local/bin/yq \
    # Add latest Active LTS node.js 24 version
    # See: https://nodejs.org/en/about/previous-releases and https://nodejs.org/en/download/current
    && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    # Writable npm global prefix so 'npm install -g' works without sudo
    && mkdir -p /home/runner/.npm-global \
    && chown -R runner:runner /home/runner/.npm-global \
    # Docker Compose v2 plugin — needed for devcontainer builds that use compose
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -SL "https://github.com/docker/compose/releases/download/v${DOCKER_COMPOSE_VERSION}/docker-compose-linux-$(uname -m)" \
         -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose \
    # Compat symlink for tools that still spawn the legacy 'docker-compose' name
    && ln -s /usr/local/lib/docker/cli-plugins/docker-compose /usr/local/bin/docker-compose \
    # Install .NET SDK — pre-installed so actions/setup-dotnet finds /usr/share/dotnet
    && curl -fsSL https://dot.net/v1/dotnet-install.sh | bash -s -- \
         --version "${DOTNET_VERSION}" --install-dir /usr/share/dotnet \
    # Clean up
    && apt-get clean \
    && rm -rf /tmp/* \
    && rm -rf /var/lib/apt/lists/*

USER runner

ENV NPM_CONFIG_PREFIX=/home/runner/.npm-global
ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH=/home/runner/.npm-global/bin:/usr/share/dotnet:$PATH
